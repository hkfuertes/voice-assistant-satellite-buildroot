config BR2_PACKAGE_LINUX_VOICE_ASSISTANT_WRAPPER
	bool "linux-voice-assistant-wrapper"
	depends on BR2_PACKAGE_PYTHON3
	select BR2_PACKAGE_LINUX_VOICE_ASSISTANT
	select BR2_PACKAGE_PYTHON_SPIDEV
	help
	  Wrapper for linux-voice-assistant with LED event support.
	  
	  Provides visual feedback through APA102 LEDs on ReSpeaker 2mic HAT
	  by intercepting voice assistant events and controlling RGB LEDs.
	  
	  https://github.com/hkfuertes/voice-assistant-satellite-buildroot

comment "linux-voice-assistant-wrapper needs Python3"
	depends on !BR2_PACKAGE_PYTHON3
